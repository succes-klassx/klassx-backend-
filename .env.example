DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_NAME unset to use SQLite locally.
DATABASE_NAME=
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Added when Module 3 (payments) is wired up:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
FRONTEND_URL=http://localhost:3000

# Konnect — paiement pour les élèves en Tunisie (Stripe ne gère pas le
# dinar tunisien). Sandbox : https://dashboard.sandbox.konnect.network
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=True

# Gel temporaire du service pour la Tunisie (compte marchand Konnect pas
# encore confirmé) — voir settings.py. Remettre à True une fois validé.
CONTACT_EMAIL=contact@klassx.cloud

# Email (leave EMAIL_BACKEND as-is to print emails to the console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@klassx.fr

# Video rooms (Daily.co) — leave empty to use placeholder links in dev
DAILY_API_KEY=

# Video rooms (Google Meet) — takes priority over Daily.co/Jitsi once
# configured. See README.md "Google Meet / Google Workspace setup".
#
# GOOGLE_SERVICE_ACCOUNT_FILE / GOOGLE_OAUTH_CLIENT_ID+SECRET are
# auto-detected from a google_credentials.json file dropped at the
# project root (next to manage.py) — you only need to set them here if
# your file is named/located differently. Leave blank to use the
# auto-detected value.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Required in all cases — cannot be auto-detected from the credentials
# file. The Workspace mailbox (or, in OAuth mode, the Google account you
# authorize with) that will own every session's Meet room.
GOOGLE_WORKSPACE_ORGANIZER_EMAIL=

# Fallback if your org blocks service account keys, or you don't have
# Workspace admin access to set up domain-wide delegation — fill these
# instead, via `python manage.py get_google_oauth_token` (reads
# google_credentials.json by default).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Brevo (ex-Sendinblue) — inscription à la newsletter depuis le footer
# de la page d'accueil. Clé API v3 : Brevo > Paramètres > Clés API.
# BREVO_NEWSLETTER_LIST_ID (facultatif) : Brevo > Contacts > Listes.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=

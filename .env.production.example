# Variables à définir (ou changer) dans le `.env` du serveur de PRODUCTION,
# en plus de celles déjà documentées dans .env.example. Les valeurs par
# défaut de .env.example sont pensées pour le développement local — plusieurs
# d'entre elles doivent être écrasées avant la mise en ligne.

# ---------------------------------------------------------------------------
# Sécurité — sans DJANGO_DEBUG=False, les pages d'erreur exposent du code
# et des infos sensibles à n'importe quel visiteur.
# ---------------------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=<générez une vraie clé aléatoire, ne réutilisez jamais celle de dev>
DJANGO_ALLOWED_HOSTS=api.klassx.fr

# HSTS — NE PAS définir cette variable tant que vous n'avez pas vérifié que
# le HTTPS fonctionne bien sur le domaine ET tous ses sous-domaines
# (www. inclus) pendant plusieurs jours. Une fois confiant, montez
# progressivement : 300 (5 min) → 86400 (1 jour) → 2592000 (30 jours) →
# 31536000 (1 an). Une mauvaise valeur ici peut rendre le site inaccessible
# jusqu'à expiration du délai, sans qu'un nouveau déploiement ne le corrige.
SECURE_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# Email — C'EST ICI QUE ÇA COINCE ACTUELLEMENT.
# En dev, EMAIL_BACKEND=console.EmailBackend affiche les emails dans le
# terminal au lieu de les envoyer — d'où l'absence d'email de confirmation
# d'inscription et de mot de passe oublié en prod si ces 6 lignes ne sont
# pas définies. Exemple avec le relais SMTP de SendGrid ci-dessous ;
# remplacez par votre fournisseur (Mailgun, Amazon SES, Brevo, OVH...).
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=<votre clé API SendGrid>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@klassx.fr

# ---------------------------------------------------------------------------
# FRONTEND_URL — utilisé dans les liens des emails (confirmation, reset de
# mot de passe) et les redirections Stripe Checkout. Laissé sur
# localhost:3000, ces liens seraient cassés pour vos utilisateurs.
# ---------------------------------------------------------------------------
FRONTEND_URL=https://klassx.fr

# ---------------------------------------------------------------------------
# CORS — n'autorisez que votre vrai domaine frontend en prod.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://klassx.fr,https://www.klassx.fr

# ---------------------------------------------------------------------------
# Base de données — sans ça, PostgreSQL n'est pas utilisé et l'app retombe
# sur SQLite (à éviter en prod : un seul fichier, pas de vraie concurrence).
# ---------------------------------------------------------------------------
DATABASE_NAME=klassx
DATABASE_USER=postgres
DATABASE_PASSWORD=<mot de passe>
DATABASE_HOST=<hôte de votre base>
DATABASE_PORT=5432

# ---------------------------------------------------------------------------
# Après avoir défini EMAIL_* ci-dessus, testez concrètement l'envoi :
#   python manage.py shell -c "from django.core.mail import send_mail; \
#     send_mail('Test KLASSX', 'ça marche', None, ['vous@exemple.com'])"
# Si ça échoue silencieusement (fail_silently=True dans
# core/services/notifications.py), vérifiez les identifiants SMTP et les
# logs de votre fournisseur plutôt que ceux de Django.
# ---------------------------------------------------------------------------
